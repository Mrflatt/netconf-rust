{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "versioning": "default",
  "include-v-in-tag": true,
  "plugins": ["cargo-workspace"],
  "changelog-sections": [
    {
      "type": "feat",
      "hidden": false,
      "section": "Features"
    },
    {
      "type": "feature",
      "hidden": false,
      "section": "Features"
    },
    {
      "type": "fix",
      "hidden": false,
      "section": "Bug Fixes"
    },
    {
      "type": "chore",
      "hidden": false,
      "section": "Miscellaneous Chores"
    },
    {
      "type": "deps",
      "hidden": false,
      "section": "Dependencies"
    }
  ],
  "packages": {
    "netconf-rust": {
      "changelog-path": "CHANGELOG.md"
    },
    "netconf-cli": {
      "changelog-path": "CHANGELOG.md"
    }
  }
}
